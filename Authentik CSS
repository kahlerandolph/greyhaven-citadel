/* =========================================================
   GREYHAVEN CITADEL
   AUTHENTIK LOGIN + BRAND THEME
   LOGIN EMBLEM + ADMIN MASTHEAD SPLIT
   ========================================================= */

/* =========================================================
   BASE GREYHAVEN PALETTE
   ========================================================= */

ak-flow-executor {
    --pf-global--primary-color--100: #9d7a45;
    --pf-global--primary-color--200: #c19a5b;

    --pf-global--Color--100: #e8e1d6;
    --pf-global--Color--200: #b9b0a3;

    --pf-global--BorderColor--100: #655944;
    --pf-global--BorderColor--200: #887451;

    --pf-global--link--Color: #c7a66b;
    --pf-global--link--Color--hover: #e3c58d;

    --ak-c-login__main-ColumnWidth: 32rem;
}


/* =========================================================
   REMOVE AUTHENTIK LOGIN SIDEBAR BACKGROUND
   ========================================================= */

.pf-c-login[data-layout^="sidebar"] {
    --ak-c-login--BackgroundColorOverlay: transparent !important;
    background: transparent !important;
}

.pf-c-login[data-layout^="sidebar"]::before {
    background: transparent !important;
    background-color: transparent !important;
    box-shadow: none !important;
}


/* =========================================================
   HIDE LANGUAGE SELECTOR
   ========================================================= */

ak-flow-executor::part(locale-select) {
    display: none !important;
}


/* =========================================================
   LOGIN CARD
   ========================================================= */

ak-flow-executor::part(main) {
    height: auto !important;
    align-self: center !important;

    width: auto !important;
    max-width: 440px !important;

    margin-left: 3rem !important;
    margin-right: 2rem !important;

    background:
        linear-gradient(
            180deg,
            rgba(10, 13, 16, 0.74),
            rgba(3, 5, 8, 0.66)
        ) !important;

    border:
        1px solid rgba(176, 139, 78, 0.78) !important;

    border-radius: 8px !important;

    box-shadow:
        0 18px 50px rgba(0, 0, 0, 0.48),
        inset 0 0 0 1px rgba(255, 255, 255, 0.02) !important;

    backdrop-filter: blur(5px);
    -webkit-backdrop-filter: blur(5px);
}


/* =========================================================
   LOGIN BRANDING AREA
   ========================================================= */

ak-flow-executor::part(branding) {
    background: transparent !important;
    border: none !important;

    padding-top: 1.25rem !important;
    padding-bottom: 0.5rem !important;
}


/* =========================================================
   GREYHAVEN LOGIN LOGO
   This continues to use the Brand -> Logo file.
   Set Brand -> Logo back to emblem.png.
   ========================================================= */

.branding-logo {
    display: block !important;

    width: auto !important;
    height: auto !important;

    max-height: 225px !important;
    max-width: 80% !important;

    margin-left: auto !important;
    margin-right: auto !important;
}


/* =========================================================
   REMOVE AUTHENTIK FOOTER
   ========================================================= */

ak-flow-executor::part(footer) {
    display: none !important;
}


/* =========================================================
   TITLES
   ========================================================= */

.pf-c-title {
    font-family:
        Georgia,
        "Times New Roman",
        serif !important;

    font-weight: 400 !important;
    letter-spacing: 0.02em !important;

    color: #eee7db !important;

    margin-top: 0.25rem !important;
    margin-bottom: 1.1rem !important;
}


/* =========================================================
   FORM LABELS
   ========================================================= */

.pf-c-form__label-text {
    color: #e8e1d6 !important;
}

.pf-c-form__label-required {
    color: #b88a52 !important;
}


/* =========================================================
   INPUT FIELDS
   ========================================================= */

.pf-c-form-control {
    background:
        rgba(4, 7, 10, 0.60) !important;

    color: #eee7db !important;

    border:
        1px solid rgba(157, 122, 69, 0.90) !important;

    border-radius: 4px !important;

    padding:
        0.72rem 0.80rem !important;

    box-shadow:
        inset 0 1px 5px rgba(0, 0, 0, 0.55) !important;
}

.pf-c-form-control:focus {
    border-color: #c19a5b !important;

    box-shadow:
        0 0 0 1px rgba(193, 154, 91, 0.35),
        inset 0 1px 5px rgba(0, 0, 0, 0.55) !important;
}

.pf-c-form-control::placeholder {
    color: #918a80 !important;
    opacity: 1 !important;
}


/* =========================================================
   PRIMARY BUTTONS
   ========================================================= */

.pf-c-button.pf-m-primary {
    position: relative !important;
    overflow: hidden !important;

    min-height: 3rem !important;
    height: 3rem !important;

    padding: 0 1rem !important;

    background:
        linear-gradient(
            180deg,
            rgba(57, 55, 53, 0.92),
            rgba(30, 31, 32, 0.88)
        ) !important;

    color: #eee7db !important;

    font-family:
        Georgia,
        "Times New Roman",
        serif !important;

    font-size: 1rem !important;
    font-weight: 400 !important;

    line-height: 1 !important;
    letter-spacing: 0.06em !important;

    border:
        1px solid #9d7a45 !important;

    border-radius: 3px !important;

    box-shadow:
        inset 0 1px rgba(255, 255, 255, 0.08),
        0 3px 7px rgba(0, 0, 0, 0.45) !important;
}

.pf-c-button.pf-m-primary:hover {
    background:
        linear-gradient(
            180deg,
            rgba(80, 72, 60, 0.95),
            rgba(41, 37, 31, 0.90)
        ) !important;

    border-color: #c19a5b !important;
    color: #ffffff !important;
}

.pf-c-button.pf-m-primary:focus {
    border-color: #d1ae70 !important;

    box-shadow:
        0 0 0 1px rgba(209, 174, 112, 0.50),
        inset 0 1px rgba(255, 255, 255, 0.08) !important;
}


/* =========================================================
   IDENTIFICATION SCREEN ONLY
   ========================================================= */

:host(ak-stage-identification)
form
.pf-c-button.pf-m-primary {
    color: transparent !important;
    font-size: 0 !important;
    text-indent: -9999px !important;
}

:host(ak-stage-identification)
form
.pf-c-button.pf-m-primary::after {
    content: "Enter The Citadel";

    position: absolute !important;

    top: 0 !important;
    right: 0 !important;
    bottom: 0 !important;
    left: 0 !important;

    display: flex !important;
    align-items: center !important;
    justify-content: center !important;

    color: #eee7db !important;

    font-family:
        Georgia,
        "Times New Roman",
        serif !important;

    font-size: 1rem !important;
    font-weight: 400 !important;

    line-height: 1 !important;
    letter-spacing: 0.06em !important;

    text-indent: 0 !important;

    pointer-events: none !important;
}

:host(ak-stage-identification)
form
.pf-c-button.pf-m-primary:hover::after {
    color: #ffffff !important;
}


/* =========================================================
   LINKS
   ========================================================= */

ak-flow-executor a {
    color: #c7a66b !important;
}

ak-flow-executor a:hover {
    color: #e3c58d !important;
}


/* =========================================================
   ADMIN GREYHAVEN MASTHEAD
   IMPORTANT:
   This replaces ONLY the admin/sidebar logo image.
   The masthead is embedded directly in the CSS, so it does
   not depend on Authentik's expiring /files token URLs.
   ========================================================= */

img[alt="authentik Logo"]:not(.branding-logo) {
    content: url("data:image/webp;base64,") !important;

    display: block !important;

    width: calc(100% - 4px) !important;
    height: auto !important;

    max-width: none !important;
    max-height: none !important;

    min-width: 0 !important;
    min-height: 0 !important;

    margin-left: auto !important;
    margin-right: auto !important;

    margin-top: -44px !important;
    margin-bottom: -16px !important;

    object-fit: contain !important;
    object-position: center center !important;

    transform: none !important;
}




/* =========================================================
   USER APPLICATION DASHBOARD MASTHEAD
   Replaces ONLY the tiny top-left User Interface brand image
   with the same embedded Greyhaven masthead used by Admin.
   The login flow continues to use Brand -> Logo (emblem.png).
   ========================================================= */

div[part="brand"].pf-c-page__header-brand {
    flex: 0 0 280px !important;
    width: 280px !important;
    min-width: 280px !important;

    display: flex !important;
    align-items: center !important;

    padding-left: 8px !important;
    padding-right: 8px !important;
}

div[part="brand"].pf-c-page__header-brand
> a.pf-c-page__header-brand-link {
    display: flex !important;
    align-items: center !important;
    justify-content: flex-start !important;

    width: 100% !important;
    height: 100% !important;
}

div[part="brand"].pf-c-page__header-brand
> a.pf-c-page__header-brand-link
> img.pf-c-brand[alt="Greyhaven Citadel"] {
    content: url("data:image/webp;base64,") !important;

    display: block !important;

    width: 250px !important;
    height: auto !important;

    max-width: 250px !important;
    max-height: 78px !important;

    margin: 0 !important;

    object-fit: contain !important;
    object-position: left center !important;

    transform: none !important;
}


/* User-interface header safety on narrower screens */
@media (max-width: 900px) {
    div[part="brand"].pf-c-page__header-brand {
        flex: 0 0 210px !important;
        width: 210px !important;
        min-width: 210px !important;

        padding-left: 6px !important;
        padding-right: 6px !important;
    }

    div[part="brand"].pf-c-page__header-brand
    > a.pf-c-page__header-brand-link
    > img.pf-c-brand[alt="Greyhaven Citadel"] {
        width: 190px !important;
        max-width: 190px !important;
        max-height: 62px !important;
    }
}

@media (max-width: 600px) {
    div[part="brand"].pf-c-page__header-brand {
        flex: 0 0 72px !important;
        width: 72px !important;
        min-width: 72px !important;

        padding-left: 6px !important;
        padding-right: 6px !important;
    }

    div[part="brand"].pf-c-page__header-brand
    > a.pf-c-page__header-brand-link
    > img.pf-c-brand[alt="Greyhaven Citadel"] {
        /*
         * On very small screens, don't cram the wide masthead.
         * Let Authentik's normal emblem remain compact.
         */
        content: normal !important;

        width: auto !important;
        height: auto !important;

        max-width: 52px !important;
        max-height: 52px !important;
    }
}


/* =========================================================
   MOBILE / SMALL SCREEN SAFETY
   ========================================================= */

@media (max-width: 768px) {

    ak-flow-executor::part(main) {
        width: auto !important;
        max-width: none !important;

        margin-left: 1rem !important;
        margin-right: 1rem !important;

        border-radius: 6px !important;
    }

    .branding-logo {
        max-height: 180px !important;
        max-width: 74% !important;
    }

    .pf-c-button.pf-m-primary {
        min-height: 3rem !important;
        height: 3rem !important;
    }

    img[alt="authentik Logo"]:not(.branding-logo) {
        width: calc(100% - 10px) !important;
        height: auto !important;

        max-height: none !important;

        margin-top: -20px !important;
        margin-bottom: -8px !important;
    }
}
